# Copy to .env for local development. Never commit real secrets.

# development | testing | production
FINTRACK_ENVIRONMENT=development
FINTRACK_LOG_LEVEL=INFO

# PostgreSQL (async driver). In docker-compose the host is "db".
FINTRACK_DATABASE_URL=postgresql+asyncpg://fintrack:change-me@localhost:5432/fintrack

# Comma-separated list of allowed CORS origins. No wildcard in production.
FINTRACK_CORS_ORIGINS=http://localhost:3000

# Signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required, at least 32 chars in production. Rotating it invalidates every
# outstanding access token (refresh tokens are unaffected - they're opaque,
# not JWTs, and are validated against the database instead).
FINTRACK_JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars-long

# Used by docker-compose to initialise the PostgreSQL container.
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fintrack
